# =========================================================
# ШАБЛОН конфигурации приложения MusicStore.
#
# НЕ КОММИТЬТЕ ЭТОТ ФАЙЛ С РЕАЛЬНЫМИ ЗНАЧЕНИЯМИ.
#
# Использование на App Server:
#   sudo mkdir -p /etc/musicstore
#   sudo cp deploy/musicstore.env.example /etc/musicstore/musicstore.env
#   sudo nano /etc/musicstore/musicstore.env    # заполнить <...>
#   sudo chown root:root /etc/musicstore/musicstore.env
#   sudo chmod 600 /etc/musicstore/musicstore.env
#   sudo systemctl restart musicstore-api
# =========================================================

# --- Общие настройки ASP.NET Core ---
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://0.0.0.0:8080

# --- Подключение к PostgreSQL ---
# Замените <DB_HOST> на IP DB Server, <DB_PASSWORD> — на реальный пароль роли musicstore_app.
ConnectionStrings__Default=Host=<DB_HOST>;Port=5432;Database=musicstore;Username=musicstore_app;Password=<DB_PASSWORD>

# --- JWT ---
# Сгенерируйте ключ: openssl rand -base64 32
Jwt__Key=<GENERATE_RANDOM_32_BYTES_BASE64>
Jwt__Issuer=MusicStoreApi
Jwt__Audience=MusicStoreClient

# --- Bootstrap-администратор (ТОЛЬКО при первом запуске) ---
# После создания администратора удалите эти две строки и перезапустите службу.
#BootstrapAdmin__Username=admin
#BootstrapAdmin__Password=<REPLACE_WITH_STRONG_PASSWORD>
