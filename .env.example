# Переменные .NET читаются через Environment или systemd EnvironmentFile.
ConnectionStrings__Default=Host=192.168.56.11;Port=5432;Database=musicstore;Username=musicstore_app;Password=REPLACE_WITH_SECRET
Jwt__Key=REPLACE_WITH_RANDOM_VALUE_AT_LEAST_32_BYTES
Jwt__Issuer=MusicStoreApi
Jwt__Audience=MusicStoreClient
Jwt__ExpiresInHours=24

# Установите только на время первого запуска, затем удалите обе переменные.
BootstrapAdmin__Username=admin
BootstrapAdmin__Password=REPLACE_WITH_UNIQUE_PASSWORD_AT_LEAST_16_CHARACTERS
